@model Resgrid.Web.Areas.User.Models.CallsDashboardModel
@using Resgrid.Model
@using Resgrid.Web.Helpers
@inject IStringLocalizer<Resgrid.Localization.Areas.User.Dispatch.Dashboard> localizer
@{
  ViewBag.Title = "Resgrid | " + @commonLocalizer["CallsModule"];
  Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
  ViewBag.LoadAngular = true;
  var mapConfig = SettingsHelper.GetDepartmentMapConfig(Resgrid.Config.InfoConfig.WebsiteKey);
}
@section Styles
  {
  <link rel="stylesheet" href="~/clib/mapMarkers/map-icons.min.css" />

  <style>
	.labels {
	color: red;
	background-color: white;
	font-family: "Lucida Grande", "Arial", sans-serif;
	font-size: 10px;
	font-weight: bold;
	text-align: center;
	width: 70px;
	border: 2px solid black;
	white-space: nowrap;
	}
	/* Incident card (A3): the expanded active-calls row. */
	.call-card-detail { padding: 10px 14px; background: #f9f9f9; border-left: 3px solid #1ab394; }
	.call-card-head { margin-bottom: 4px; }
	.call-card-time { color: #888; margin-right: 8px; }
	.call-card-typeid { font-weight: 600; margin-right: 8px; }
	.call-card-number { margin-right: 8px; }
	.call-card-address { margin-bottom: 6px; }
	.call-card-label { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: #999; margin-right: 6px; }
	.call-card-chip { display: inline-block; background-color: #777; color: #fff; padding: 2px 6px; border-radius: 3px; margin: 0 4px 2px 0; font-size: 12px; }
	.call-card-timeline { list-style: none; margin: 4px 0 0; padding: 0; }
	.call-card-timeline li { border-left: 2px solid #e7eaec; padding: 2px 0 6px 8px; }
	.call-card-note-name { font-weight: 600; margin-right: 6px; }
	.call-card-note-time { color: #999; font-size: 12px; }
	/* Station strips (A5/A6). */
	.strip-line { margin-bottom: 2px; }
	.strip-big { font-size: 20px; font-weight: 700; margin-right: 2px; }
	.strip-oos { color: #c0392b; margin-left: 14px; }
	.strip-label { color: #888; font-size: 12px; }
	.strip-sub { color: #666; font-size: 12px; margin: 2px 0 6px; }
	.strip-sev { display: inline-block; background: #f39c12; color: #fff; padding: 1px 5px; border-radius: 3px; font-size: 11px; text-transform: uppercase; }
	.strip-none { margin-bottom: 0; }
	.strip-events { list-style: none; margin: 0; padding: 0; }
	.strip-events li { padding: 2px 0; border-bottom: 1px solid #f0f0f0; }
	.strip-events li:last-child { border-bottom: none; }
	.strip-event-time { color: #888; font-size: 12px; margin-right: 6px; }
  </style>
}

<div class="row wrapper border-bottom white-bg page-heading">
  <div class="col-sm-4">
    <h2>@commonLocalizer["CallsModule"]</h2>
    <ol class="breadcrumb">
      <li>
        <a asp-controller="Home" asp-action="Dashboard" asp-route-area="User">@commonLocalizer["HomeModule"]</a>
      </li>
      <li class="active">
        <strong>@commonLocalizer["CallsModule"]</strong>
      </li>
    </ol>
  </div>
  <div class="col-sm-8">
    <div class="btn-group top-page-buttons" style="float:right;padding-right:15px;">
      <div class="buttons-actions">
        @if (ClaimsAuthorizationHelper.CanViewRoutes())
        {
          <a id="routesButton" class="btn btn-inverse" asp-controller="Routes" asp-action="Index" asp-route-area="User">@localizer["Routes"]</a>
        }
        <a title="@localizer["ArchivedCalls"]" class="btn btn-info" asp-controller="Dispatch" asp-action="ArchivedCalls" asp-route-area="User">@localizer["ArchivedCalls"]</a>
        <a title="@localizer["ScheduledCalls"]" class="btn btn-warning" asp-controller="Dispatch" asp-action="ScheduledCalls" asp-route-area="User">@localizer["ScheduledCalls"]</a>
        @if (ClaimsAuthorizationHelper.CanCreateCall())
        {
          <a id="newCallButton" title="@localizer["NewCallHelp"]" class="btn btn-success" href="@Url.Action("NewCall", "Dispatch", new { area = "User" })">@localizer["NewCall"]</a>
        }
      </div>
    </div>
  </div>
</div>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-8">
      <div class="ibox float-e-margins">
        <div class="ibox-title">
          <h5>@localizer["UnitStatusesHeader"]</h5>
        </div>
        <div class="ibox-content">
          <table id="unitsStatusesList" class="table table-striped table-bordered table-hover" width="100%"></table>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
  <rg-map showbuttons="false" mapheight="330px" departmentId="@ClaimsAuthorizationHelper.GetDepartmentId()" leafletosmurl="@mapConfig.TileUrl" mapattribution="@mapConfig.Attribution" mapprovider="@mapConfig.MapProvider" mapstyleurl="@mapConfig.StyleUrl" mapaccesstoken="@mapConfig.AccessToken"></rg-map>
          <br/>
        </div>
      </div>
    </div>

  </div>

  <div class="row">
    <div class="col-lg-4">
      <div class="ibox float-e-margins">
        <div class="ibox-title">
          <h5>@localizer["ApparatusHeader"]</h5>
        </div>
        <div class="ibox-content" id="apparatusStrip"></div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="ibox float-e-margins">
        <div class="ibox-title">
          <h5>@localizer["WeatherHeader"]</h5>
        </div>
        <div class="ibox-content" id="weatherStrip"></div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="ibox float-e-margins">
        <div class="ibox-title">
          <h5>@localizer["EventsHeader"]</h5>
        </div>
        <div class="ibox-content" id="eventsStrip"></div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-title">
          <h5>@localizer["NowRespondingHeader"]</h5>
        </div>
        <div class="ibox-content" id="nowRespondingPanel">
          @await Html.PartialAsync("_NowRespondingPartial", Model.NowResponding)
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-title">
          <h5>@localizer["ActiveCallsHeader"]</h5>
          <div class="ibox-tools">
            @if (ClaimsAuthorizationHelper.CanCreateCall())
			{
              <div class="buttons-actions">
                <a id="addPersonButton" title="@localizer["NewCallHelp"]" class="btn btn-success" href="@Url.Action("NewCall", "Dispatch", new {area = "User"})">@localizer["NewCall"]</a>
              </div>
			}
          </div>
        </div>
        <div class="ibox-content">
          <table id="activeCallsList" class="table table-striped table-bordered table-hover" width="100%"></table>
        </div>
      </div>
    </div>

  </div>
</div>

@section Scripts
  {
  <script>
		var centerLat = '@Model.Latitude';
		var centerLon = '@Model.Longitude';
  </script>

  @await Html.PartialAsync("_DispatchLocalizationScript")
  <script src="~/js/app/common/signalr/resgrid.common.signalr.js" type="text/javascript"></script>
  <script src="~/js/app/internal/dispatch/resgrid.dispatch.callcard.js" type="text/javascript"></script>
  <script src="~/js/app/internal/dispatch/resgrid.dispatch.strips.js" type="text/javascript"></script>
  <script src="~/js/app/internal/dispatch/resgrid.dispatch.dashboard.js" type="text/javascript"></script>
}
